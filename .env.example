# Copiar a .env (ignorado por Git) y cambiar la contraseña. Nunca versionar el .env real.

# PostgreSQL
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=CAMBIAR_EN_LOCAL

# Kafka (dentro de la red de Compose se usa el nombre del servicio, no localhost)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=terremotos.live
KAFKA_CONSUMER_GROUP=consumidor-live

# API: origen permitido por CORS (mapa en desarrollo)
API_CORS_ORIGINS=http://localhost:4200

# Ingesta de USGS (productor). INGESTA_PUBLICAR=false (seguro por defecto): modo seco, consulta y registra sin publicar. Poner true en el .env local para publicar en Kafka.
USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_INTERVAL_S=60
USGS_TIMEOUT_S=20
USGS_MAX_REINTENTOS=3
RETENCION_RESPUESTAS_DIAS=3
RETENCION_CONSULTAS_DIAS=30
INGESTA_PUBLICAR=false

# Geografía (F4): catálogo de países montado de solo lectura en el consumidor (ruta dentro del contenedor).
CATALOGO_PATH=/datos/paises.geojson

# Carga histórica de USGS (F4, paso 4.4): año, magnitud mínima y límite por consulta (USGS admite como máximo 20000).
HISTORICO_ANIO=2025
HISTORICO_MAG_MIN=4
HISTORICO_LIMITE=20000
HISTORICO_TIMEOUT_S=60
HISTORICO_MAX_REINTENTOS=3
# Carpeta (dentro del contenedor) donde se exportan los archivos originales; se monta con -v ./data/historico:/exportacion
HISTORICO_EXPORT_DIR=/exportacion

# Detección de huecos de ingesta (F4, paso 4.5): margen en segundos aplicado por ambos lados del intervalo sin cobertura (21600 = 6 h).
HUECO_MARGEN_S=21600

# API de consulta (F5): máximo de eventos por respuesta, de casillas horarias, umbral de ingesta obsoleta (s), tiempo máximo por consulta (s) y margen de publicación (s).
API_MAX_EVENTOS=5000
API_MAX_VENTANA_HORAS=744
INGESTA_OBSOLETA_S=300
API_STATEMENT_TIMEOUT_S=10
API_MARGEN_PUBLICACION_S=900

# Replay histórico aislado (F6, DG1/DG3): topic y grupo PROPIOS (nunca los del flujo en vivo), tamaño de la selección, segundos entre mensajes
# y esperas del consumidor de replay (inactividad tras el primer mensaje procesado / tope sin ningún mensaje).
KAFKA_TOPIC_REPLAY=terremotos.replay
KAFKA_CONSUMER_GROUP_REPLAY=consumidor-replay
REPLAY_EVENTOS=30
REPLAY_INTERVALO_S=2
REPLAY_ESPERA_FINAL_S=10
REPLAY_ESPERA_MAX_S=120

# Despliegue (F6, DG7): puerto del equipo donde se publica la API (solo en 127.0.0.1) y etiqueta de la imagen. Solo se cambian para un
# proyecto Compose paralelo (docker compose -p observatorio_limpio ...); los valores por defecto son los del sistema real.
API_PUERTO=8000
BACKEND_IMAGE=observatorio-backend
